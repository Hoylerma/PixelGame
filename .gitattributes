# Normalise text files
* text=auto

# Code & data
*.cs        text diff=csharp
*.asmdef    text
*.json      text
*.md        text
*.uxml      text
*.uss       text

# Unity YAML (Force Text serialisation)
*.unity       text eol=lf
*.prefab      text eol=lf
*.asset       text eol=lf
*.meta        text eol=lf
*.mat         text eol=lf
*.anim        text eol=lf
*.controller  text eol=lf
*.overrideController text eol=lf
*.physicsMaterial2D  text eol=lf
*.spriteatlas text eol=lf
*.spriteatlasv2 text eol=lf

# Binary art & audio (pixel art is tiny; switch these to Git LFS if audio grows large)
*.png       binary
*.aseprite  binary
*.ase       binary
*.psd       binary
*.wav       binary
*.ogg       binary
*.mp3       binary
*.ttf       binary
*.otf       binary
